<section id="contact" class="card">
      <h2 class="text-2xl font-bold mb-4">Let's build together!</h2>
      <div class="accent-line"></div>
      <form action="#" class="flex flex-col gap-4 text-left">
        <label for="name" class="font-semibold text-sm">Name</label>
        <input type="text" id="name" name="name" required class="inp" placeholder="Your name">


        <label for="email" class="font-semibold text-sm">Email</label>
        <input type="email" id="email" name="email" required class="inp" placeholder="you@example.com">


        <label for="message" class="font-semibold text-sm">Message</label>
        <textarea id="message" name="message" rows="5" required class="inp" placeholder="Your message..."></textarea>


        <button type="submit" class="btn-primary bg-yellow-500 dark:bg-yellow-500">Send Message</button>
      </form>
    </section>