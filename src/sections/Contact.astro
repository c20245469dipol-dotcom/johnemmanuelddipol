<section id="contact" class="reveal neu p-6">
            <span class="neu-in inline-block px-2.5 py-1 rounded-full text-[10px] font-extrabold tracking-widest uppercase t-accent mb-3">Contact</span>
            <h2 class="text-2xl font-extrabold">Reserve your seat.</h2>
            <form action="#" class="mt-4 space-y-3">
                <div>
                    <label for="name" class="block text-[10px] font-extrabold uppercase tracking-widest t-muted mb-1">Name</label>
                    <input type="text" id="name" name="name" required
                           class="field w-full px-3 py-2.5 text-sm" />
                </div>
                <div>
                    <label for="email" class="block text-[10px] font-extrabold uppercase tracking-widest t-muted mb-1">Email</label>
                    <input type="email" id="email" name="email" required
                           class="field w-full px-3 py-2.5 text-sm" />
                </div>
                <div>
                    <label for="message" class="block text-[10px] font-extrabold uppercase tracking-widest t-muted mb-1">Message</label>
                    <textarea id="message" name="message" rows="3" required
                              class="field w-full px-3 py-2.5 text-sm resize-none"></textarea>
                </div>
                <button type="submit" class="neu-accent w-full py-2.5 text-sm font-bold">Send Message</button>
            </form>
            <p class="mt-4 text-xs t-muted"> LOCATION : Brgy 1-A Manapla</p>
        </section>